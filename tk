#!/usr/bin/env python3
"""tickmark (tk) - session task tracker for agent CLIs with no native todo tool.

Why this exists
---------------
Coding agents that ship a todo tool render a live checklist in the terminal, so
the human watching can see where the work is. Agents that don't ship one leave
the human with a wall of scrolling text and a summary at the very end.

tk gives that checklist back, to any agent, without an API, a daemon or a
plugin system: it is a single Python file with no dependencies that any agent
can call as a shell command.

Design notes
------------
- State lives in one JSON file per project (git root when there is one, current
  directory otherwise), so two projects never share a list. Set TICKMARK_SESSION
  to split that further when several agents work in one checkout at once.
- Every command reprints the full list. One call both updates the state and
  shows where things stand, which is exactly one tool call for the agent.
- The state file is plain JSON on purpose: a status line, a prompt hook or
  another tool can read it without going through tk.
- The task in progress carries the epoch second it started, under "since". It
  is rendered at the end of that one line, so a step stuck for eight minutes
  says so on its own. Older lists have no "since" and simply show no duration.
"""
import hashlib
import json
import os
import shutil
import subprocess
import sys
import time

__version__ = "1.0.0"

HOME = os.path.expanduser("~")
XDG = os.environ.get("XDG_DATA_HOME") or os.path.join(HOME, ".local", "share")
STORE = os.environ.get("TICKMARK_STORE") or os.path.join(XDG, "tickmark")
LEGACY_STORE = os.path.join(HOME, ".local", "share", "agy-tasks")

# Two agents working in one checkout share a project root, so they share a list
# and overwrite each other. Nothing in the environment tells them apart on its
# own: a process session id changes between two calls of the same agent (an
# agent CLI spawns a fresh shell per command), and a tty is absent as soon as
# output is captured.
#
# So we look for an identifier the runner already publishes. TICKMARK_SESSION
# wins when set. Otherwise we fall back to the variables agent runners export
# to name the agent they just started -- that covers the common case where
# several agents share one checkout and nobody remembered to set anything.
# A plain human shell exports none of these, so the list stays per project and
# the file name is the one earlier versions wrote.
#
# Why the fallback matters: opt-in alone reproduces the bug it was meant to
# fix. An agent that forgets the variable silently joins another agent's list,
# sees tasks it never created, and overwrites them on its next call.
SESSION = (
    os.environ.get("TICKMARK_SESSION")
    or os.environ.get("AGENT_ID")
    or os.environ.get("AGENT_NAME")
    or ""
)

MARK = {"todo": "○", "doing": "▸", "done": "✔"}
COLOR = {"todo": "\033[2m", "doing": "\033[1;33m", "done": "\033[32m"}
RESET = "\033[0m"

# The duration sits at the end of the line in progress. Two spaces, no column,
# no frame: every command reprints the whole list, so anything that adds a line
# or a box is paid again on every single call.
GAP = "  "
# Below this many columns left for the subject, the duration goes rather than
# the subject. The subject is what the line is for.
MIN_SUBJECT = 8

# The display language follows the shell locale. The agent-facing contract
# (command names, JSON keys) never changes, so instructions stay portable.
FR = (os.environ.get("LC_ALL") or os.environ.get("LC_MESSAGES")
      or os.environ.get("LANG") or "").lower().startswith("fr")

STRINGS = {
    "empty": ("Aucune tache. tk add \"<sujet>\" pour commencer.",
              "No tasks yet. tk add \"<subject>\" to start."),
    "count": ("Taches %d/%d", "Tasks %d/%d"),
    "need_subject": ("tk add attend au moins un sujet entre guillemets.",
                     "tk add expects at least one quoted subject."),
    "need_number": ("tk %s attend le numero d'une tache existante.",
                    "tk %s expects the number of an existing task."),
    "unknown": ("Commande inconnue : %s", "Unknown command: %s"),
    "shifted": ("Numeros redistribues : utilise ceux ci-dessus, pas ceux que "
                "tu avais en tete.",
                "Numbers were reassigned: use the ones above, not the ones you "
                "had in mind."),
}

USAGE = """tickmark %s - session task tracker

  tk add "<subject>" ["<subject>" ...]   add one or more tasks
  tk go <n>                              mark task n as in progress
  tk ok <n> [<n> ...]                    complete one or more tasks
  tk next                                complete the current task, start the next
  tk rm <n> [<n> ...]                    remove one or more tasks
  tk new                                 clear the list
  tk                                     show the list
  tk --json                              show the list as JSON (for status lines)

State: %s
Parallel agents in one checkout get separate lists automatically (AGENT_ID).
  Set TICKMARK_SESSION to override or to split a plain shell.
""" % (__version__, STORE)


def s(key, *args):
    text = STRINGS[key][0 if FR else 1]
    return text % args if args else text


def project_root():
    """The git root when there is one, the working directory otherwise."""
    try:
        out = subprocess.run(
            ["git", "rev-parse", "--show-toplevel"],
            stdout=subprocess.PIPE, stderr=subprocess.PIPE,
            universal_newlines=True, timeout=3,
        )
        if out.returncode == 0 and out.stdout.strip():
            return out.stdout.strip()
    except Exception:
        pass
    return os.getcwd()


def remember_root(cwd, root):
    """Record working directory -> project root.

    A status line can then find the right list without shelling out to git on
    every repaint. Written atomically: several agents may run at once.
    """
    p = os.path.join(STORE, "roots.json")
    try:
        with open(p) as f:
            roots = json.load(f)
    except (OSError, json.JSONDecodeError):
        roots = {}
    if roots.get(cwd) == root:
        return
    roots[cwd] = root
    tmp = "%s.%d.tmp" % (p, os.getpid())
    try:
        with open(tmp, "w") as f:
            json.dump(roots, f)
        os.replace(tmp, p)
    except OSError:
        pass


def state_path():
    root = project_root()
    os.makedirs(STORE, exist_ok=True)
    remember_root(os.getcwd(), root)
    name = hashlib.sha1(root.encode()).hexdigest()[:16]
    if SESSION:
        name += "-" + hashlib.sha1(SESSION.encode()).hexdigest()[:8]
    name += ".json"
    path = os.path.join(STORE, name)
    # One-shot migration from the pre-1.0 store, so an existing list is not
    # silently lost the day someone installs tickmark over it. Only for the
    # unsplit list: copying one legacy file into every session would hand the
    # same stale tasks to every agent.
    if not SESSION and not os.path.exists(path):
        legacy = os.path.join(LEGACY_STORE, name)
        if os.path.exists(legacy):
            try:
                with open(legacy) as src, open(path, "w") as dst:
                    dst.write(src.read())
            except OSError:
                pass
    return path


def load():
    p = state_path()
    if not os.path.exists(p):
        return []
    try:
        with open(p) as f:
            data = json.load(f)
    except (json.JSONDecodeError, OSError):
        return []
    if not isinstance(data, list):
        return []
    # A hand-edited or half-written file must not crash the next command.
    return [t for t in data
            if isinstance(t, dict) and t.get("s") in MARK
            and isinstance(t.get("t"), str)]


def save(tasks):
    """Replace the state file in one step.

    Same reason as remember_root: several agents may run at once, and a reader
    that catches a half-written file gets invalid JSON, which load() reads as an
    empty list. The checklist would then vanish without an error.
    """
    p = state_path()
    tmp = "%s.%d.tmp" % (p, os.getpid())
    with open(tmp, "w") as f:
        json.dump(tasks, f, ensure_ascii=False)
    os.replace(tmp, p)


def use_color():
    """Colour only when a person is looking at a terminal."""
    return (sys.stdout.isatty() and not os.environ.get("NO_COLOR")
            and os.environ.get("TERM") != "dumb")


def term_width():
    """Usable width, or 0 when there is no terminal to fit."""
    columns = os.environ.get("COLUMNS", "")
    if columns.isdigit():
        return int(columns)
    if sys.stdout.isatty():
        return shutil.get_terminal_size().columns
    return 0


def elapsed(since, now):
    """How long the current task has been running, or "" when unknowable.

    Five or six characters from one minute on, so the end of the line stays put
    between two reprints of the same list instead of dancing left and right.
    The trailing number is padded ("1m09s", not "1m9s"), which is what would
    otherwise move it every ten seconds; the leading one is not, because the
    shape to read at a glance is "2m14s". It gains a character when it gains a
    digit, once per scale.

    Anything that is not a usable number reads as "no duration", never as an
    error: the store can be hand-edited, and half a list is better than none.
    """
    if isinstance(since, bool) or not isinstance(since, (int, float)):
        return ""
    try:
        seconds = int(now - since)
    except (ValueError, OverflowError):  # nan, inf
        return ""
    if seconds < 0:  # a clock that went backwards, or a store from elsewhere
        seconds = 0
    if seconds < 60:
        return "%ds" % seconds
    if seconds < 3600:
        return "%dm%02ds" % (seconds // 60, seconds % 60)
    if seconds < 86400:
        return "%dh%02dm" % (seconds // 3600, seconds % 3600 // 60)
    return "%dd%02dh" % (seconds // 86400, seconds % 86400 // 3600)


def render(tasks, now=None):
    if not tasks:
        return s("empty")
    width = term_width()
    color = use_color()
    if now is None:
        now = time.time()
    done = sum(1 for t in tasks if t["s"] == "done")
    lines = [s("count", done, len(tasks))]
    for i, t in enumerate(tasks, 1):
        head = "%s %d " % (MARK[t["s"]], i)
        subject = t["t"]
        tail = ""
        if t["s"] == "doing":
            duration = elapsed(t.get("since"), now)
            if duration:
                tail = GAP + duration
        room = width - len(head) - len(tail)
        # A terminal too narrow for both drops the duration whole. Cutting it in
        # two would print a number that is not a number; shrinking the subject
        # to nothing would print a line that says nothing.
        if width and tail and room < MIN_SUBJECT:
            tail = ""
            room = width - len(head)
        # ponytail: counts characters, not display columns. A subject in CJK or
        # emoji can still spill by a column; switch to wcwidth if that shows up.
        if width and room > 0 and len(subject) > room:
            subject = subject[:room - 1] + "…" if room > 1 else "…"
        line = head + subject + tail
        lines.append(COLOR[t["s"]] + line + RESET if color else line)
    return "\n".join(lines)


def pick(tasks, args):
    """Turn arguments into valid indices, ignoring anything else."""
    out = []
    for a in args:
        if a.isdigit() and 1 <= int(a) <= len(tasks):
            out.append(int(a) - 1)
    return out


def main():
    argv = sys.argv[1:]
    shifted = False
    cmd = argv[0] if argv else "ls"
    rest = argv[1:]

    if cmd in ("-h", "--help", "help"):
        print(USAGE, end="")
        return 0
    if cmd in ("-V", "--version"):
        print("tickmark %s" % __version__)
        return 0

    tasks = load()

    if cmd == "--json":
        print(json.dumps(tasks, ensure_ascii=False))
        return 0

    if cmd == "add":
        subjects = [x.strip() for x in rest if x.strip()]
        if not subjects:
            print(s("need_subject"), file=sys.stderr)
            return 1
        tasks += [{"t": x, "s": "todo"} for x in subjects]
    elif cmd == "go":
        idx = pick(tasks, rest)
        if not idx:
            print(s("need_number", "go"), file=sys.stderr)
            return 1
        target = tasks[idx[0]]
        for t in tasks:
            if t["s"] == "doing" and t is not target:
                # Sent back to todo: it is not running any more, so it has no
                # "running since". Keeping the old stamp would count the time it
                # spent parked as time spent working the next time it is picked.
                t["s"] = "todo"
                t.pop("since", None)
        # Already the current task: leave the clock alone. Restarting it on a
        # repeated `tk go` would erase the eight-minute stall this exists to
        # show, and an agent re-stating where it is does that all the time. A
        # task left doing by an older tk has no clock at all, so start one.
        if target["s"] != "doing" or not elapsed(target.get("since"), time.time()):
            target["s"] = "doing"
            target["since"] = int(time.time())
    elif cmd == "ok":
        idx = pick(tasks, rest)
        if not idx:
            print(s("need_number", "ok"), file=sys.stderr)
            return 1
        for i in idx:
            tasks[i]["s"] = "done"
            tasks[i].pop("since", None)
    elif cmd == "next":
        for t in tasks:
            if t["s"] == "doing":
                t["s"] = "done"
                t.pop("since", None)
        for t in tasks:
            if t["s"] == "todo":
                t["s"] = "doing"
                t["since"] = int(time.time())
                break
    elif cmd == "rm":
        idx = pick(tasks, rest)
        if not idx:
            print(s("need_number", "rm"), file=sys.stderr)
            return 1
        drop = set(idx)
        tasks = [t for i, t in enumerate(tasks) if i not in drop]
        # Removing task 1 turns task 3 into task 2. An agent that had planned
        # "tk ok 3" would then tick the wrong line, with nothing to show for it.
        shifted = min(drop) < len(tasks)
    elif cmd == "new":
        tasks = []
    elif cmd != "ls":
        print(s("unknown", cmd) + "\n", file=sys.stderr)
        print(USAGE, end="", file=sys.stderr)
        return 1

    save(tasks)
    print(render(tasks))
    if shifted:
        print(s("shifted"))
    return 0


if __name__ == "__main__":
    sys.exit(main())
